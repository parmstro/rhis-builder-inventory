---
# transfer_to_drive.yml
# Generated by export_deployment.sh at @@LOG_TIMESTAMP@@
# DO NOT EDIT — regenerate by re-running export_deployment.sh on the lowside.
#
# Source provisioner: @@PROVISIONER_HOST@@
# Source satellite:   @@SAT_HOST@@
# Staging path:       @@EXPORT_STAGING@@
# Pulp export path:   @@PULP_EXPORT_PATH@@
# Highside target:    @@HIGHSIDE_DOMAIN@@
#
# Run via transfer_to_drive.sh — do not call ansible-playbook directly.
# The wrapper generates the required inventory and passes drive_mount as an extra var.
#
# Sudo note:
#   ansible.posix.synchronize with become: true injects --rsync-path="sudo rsync",
#   which requires NOPASSWD sudo for /usr/bin/rsync on the satellite. Regular tasks
#   (stat, command) use Ansible's normal become mechanism and work with either
#   passwordless sudo or --ask-become-pass. See transfer_to_drive.sh --help.


- name: "Preflight — check connectivity, paths, and drive space"
  hosts: localhost
  gather_facts: false
  tags: [preflight, transfer]

  tasks:
    - name: "Assert drive_mount is provided"
      ansible.builtin.assert:
        that: drive_mount | default('') | length > 0
        fail_msg: "drive_mount is required — pass -e drive_mount=/path/to/drive"

    - name: "Check drive mount exists and is a directory"
      ansible.builtin.stat:
        path: "{{ drive_mount }}"
      register: _drive_stat

    - name: "Fail if drive mount not found"
      ansible.builtin.fail:
        msg: "Drive mount not found or is not a directory: {{ drive_mount }}"
      when: not _drive_stat.stat.exists or not _drive_stat.stat.isdir

    - name: "Check staging path on provisioner"
      ansible.builtin.stat:
        path: "@@EXPORT_STAGING@@"
      delegate_to: "@@PROVISIONER_HOST@@"
      register: _staging_stat

    - name: "Fail if staging not found on provisioner"
      ansible.builtin.fail:
        msg: "Staging not found on provisioner @@PROVISIONER_HOST@@: @@EXPORT_STAGING@@"
      when: not _staging_stat.stat.exists

    - name: "Check Pulp export path on satellite (requires sudo)"
      ansible.builtin.stat:
        path: "@@PULP_SRC_ROOT@@"
      delegate_to: "@@SAT_HOST@@"
      become: true
      register: _pulp_stat

    - name: "Fail if Pulp path not found on satellite"
      ansible.builtin.fail:
        msg: "Pulp export path not found on @@SAT_HOST@@: @@PULP_SRC_ROOT@@"
      when: not _pulp_stat.stat.exists

    - name: "Get staging size from provisioner"
      ansible.builtin.command:
        cmd: "du -sb @@EXPORT_STAGING@@"
      delegate_to: "@@PROVISIONER_HOST@@"
      register: _staging_du
      changed_when: false

    - name: "Get Pulp export size from satellite (requires sudo)"
      ansible.builtin.command:
        cmd: "du -sb @@PULP_SRC_ROOT@@"
      delegate_to: "@@SAT_HOST@@"
      become: true
      register: _pulp_du
      changed_when: false

    - name: "Get drive available space"
      ansible.builtin.command:
        cmd: "df -B1 --output=avail {{ drive_mount }}"
      register: _drive_df
      changed_when: false

    - name: "Calculate transfer sizes"
      ansible.builtin.set_fact:
        _staging_bytes: "{{ _staging_du.stdout.split()[0] | int }}"
        _pulp_bytes: "{{ _pulp_du.stdout.split()[0] | int }}"
        _drive_avail_bytes: "{{ _drive_df.stdout_lines[-1] | trim | int }}"
        _total_bytes: "{{ (_staging_du.stdout.split()[0] | int) + (_pulp_du.stdout.split()[0] | int) }}"

    - name: "Show transfer plan"
      ansible.builtin.debug:
        msg:
          - "════════════════════════════════════════════════════════════════"
          - "  RHIS Transfer Drive — Data Transfer Plan"
          - "════════════════════════════════════════════════════════════════"
          - "  Highside target: @@HIGHSIDE_DOMAIN@@"
          - "  Drive mount:     {{ drive_mount }}"
          - "  Provisioner:     @@PROVISIONER_HOST@@"
          - "  Satellite:       @@SAT_HOST@@"
          - "  Staging:         {{ _staging_bytes | int | human_readable }}"
          - "  Pulp content:    {{ _pulp_bytes | int | human_readable }}"
          - "  Total to write:  {{ _total_bytes | int | human_readable }} ({{ _staging_bytes | int | human_readable }} staging + {{ _pulp_bytes | int | human_readable }} Pulp)"
          - "  Drive available: {{ _drive_avail_bytes | int | human_readable }}"
          - "  RHEL DVD ISO:    {{ ('@@RHEL_DVD_ISO_PATH@@' | length > 0) | ternary('will be copied from provisioner', 'not configured') }}"
          - "  Satellite ISO:   {{ ('@@SAT_DVD_ISO_PATH@@' | length > 0) | ternary('will be copied from provisioner', 'not configured') }}"
          - "════════════════════════════════════════════════════════════════"

    - name: "Fail if insufficient drive space"
      ansible.builtin.fail:
        msg: >-
          Insufficient space on {{ drive_mount }}.
          Required: ~{{ _total_bytes | int | human_readable }},
          Available: {{ _drive_avail_bytes | int | human_readable }}.
          Use a larger drive or clear space before transferring.
      when: (_drive_avail_bytes | int) < (_total_bytes | int)

    - name: "Dry-run complete — no transfer performed"
      ansible.builtin.meta: end_play
      when: dry_run | default(false) | bool


- name: "Transfer 1 — Rsync staging artifacts from provisioner to drive"
  hosts: "@@PROVISIONER_HOST@@"
  gather_facts: false
  tags: [transfer]

  pre_tasks:
    - name: "Ensure rsync is installed on provisioner"
      ansible.builtin.package:
        name: rsync
        state: present
      become: true

  tasks:
    - name: "Rsync staging from provisioner — please wait..."
      ansible.posix.synchronize:
        src: "@@EXPORT_STAGING@@/"
        dest: "{{ drive_mount }}/"
        mode: pull
        recursive: true
        delete: false
        rsync_opts:
          - "--progress"
          - "--human-readable"
          - "--omit-dir-times"
          - "--no-perms"
          - "--no-owner"
          - "--no-group"


- name: "Transfer 1b — Copy infra ISOs from provisioner to drive"
  hosts: "@@PROVISIONER_HOST@@"
  gather_facts: false
  tags: [transfer]

  tasks:
    - name: "Check RHEL DVD ISO on provisioner"
      ansible.builtin.stat:
        path: "@@RHEL_DVD_ISO_PATH@@"
      register: _rhel_iso_stat
      when: '"@@RHEL_DVD_ISO_PATH@@" | length > 0'

    - name: "Warn — RHEL DVD ISO not found on provisioner"
      ansible.builtin.debug:
        msg: "WARNING: RHEL DVD ISO not found at @@RHEL_DVD_ISO_PATH@@ — infra_isos/ will not contain RHEL DVD"
      when: '_rhel_iso_stat is defined and not _rhel_iso_stat.stat.exists'

    - name: "Copy RHEL DVD ISO to drive — please wait (large file)..."
      ansible.posix.synchronize:
        src: "@@RHEL_DVD_ISO_PATH@@"
        dest: "{{ drive_mount }}/bootstrap/infra_isos/"
        mode: pull
        rsync_opts:
          - "--progress"
          - "--human-readable"
          - "--no-perms"
          - "--no-owner"
          - "--no-group"
      when: '_rhel_iso_stat is defined and _rhel_iso_stat.stat.exists'

    - name: "Check Satellite DVD ISO on provisioner"
      ansible.builtin.stat:
        path: "@@SAT_DVD_ISO_PATH@@"
      register: _sat_iso_stat
      when: '"@@SAT_DVD_ISO_PATH@@" | length > 0'

    - name: "Warn — Satellite DVD ISO not found on provisioner"
      ansible.builtin.debug:
        msg: "WARNING: Satellite DVD ISO not found at @@SAT_DVD_ISO_PATH@@ — infra_isos/ will not contain Satellite DVD"
      when: '_sat_iso_stat is defined and not _sat_iso_stat.stat.exists'

    - name: "Copy Satellite DVD ISO to drive — please wait (large file)..."
      ansible.posix.synchronize:
        src: "@@SAT_DVD_ISO_PATH@@"
        dest: "{{ drive_mount }}/bootstrap/infra_isos/"
        mode: pull
        rsync_opts:
          - "--progress"
          - "--human-readable"
          - "--no-perms"
          - "--no-owner"
          - "--no-group"
      when: '_sat_iso_stat is defined and _sat_iso_stat.stat.exists'


- name: "Transfer 2 — Create Pulp org directory on drive"
  hosts: localhost
  gather_facts: false
  tags: [transfer]

  tasks:
    - name: "Create Pulp org directory on drive"
      ansible.builtin.file:
        path: "{{ drive_mount }}/@@PULP_ORG_DIR@@"
        state: directory
        mode: '0755'


- name: "Transfer 3 — Rsync Pulp content from satellite to drive"
  hosts: "@@SAT_HOST@@"
  gather_facts: false
  become: true
  tags: [transfer]
  # NOTE: Do not convert this play to async/poll. ansible.posix.synchronize opens
  # its own SSH connection for rsync (outside Ansible's normal task model) and the
  # become: true / rsync_path sudo injection is not reliably handled under async.
  # A blocking task is correct here — keep it that way.

  tasks:
    - name: "Rsync Pulp content from satellite — please wait (large transfer)..."
      ansible.posix.synchronize:
        src: "@@PULP_SRC_ROOT@@/"
        dest: "{{ drive_mount }}/@@PULP_ORG_DIR@@/"
        mode: pull
        recursive: true
        delete: false
        rsync_path: "sudo rsync"
        rsync_opts:
          - "--progress"
          - "--human-readable"
          - "--omit-dir-times"
          - "--no-perms"
          - "--no-owner"
          - "--no-group"


- name: "Validate drive and report"
  hosts: localhost
  gather_facts: false
  tags: [transfer]

  tasks:
    - name: "Check for validate_import_bundle.sh on drive"
      ansible.builtin.stat:
        path: "{{ drive_mount }}/validate_import_bundle.sh"
      register: _validate_stat

    - name: "Warn if validate script missing"
      ansible.builtin.debug:
        msg: "WARNING: validate_import_bundle.sh not found on drive — skipping validation"
      when: not _validate_stat.stat.exists

    - name: "Run validate_import_bundle.sh"
      ansible.builtin.shell:
        cmd: >-
          bash {{ drive_mount }}/validate_import_bundle.sh -d {{ drive_mount }} 2>&1 | sed 's/\x1b\[[0-9;]*m//g'
      when: _validate_stat.stat.exists
      register: _validate_result
      changed_when: false

    - name: "Show validation output"
      ansible.builtin.debug:
        msg: "{{ _validate_result.stdout_lines }}"
      when: _validate_stat.stat.exists

    - name: "Transfer complete — next steps"
      ansible.builtin.debug:
        msg:
          - "════════════════════════════════════════════════════════════════"
          - "  Transfer Complete — Drive Ready"
          - "════════════════════════════════════════════════════════════════"
          - "  Drive validated. Safe to transport."
          - ""
          - "  Next steps on the highside:"
          - "  1. Physically transport the drive to the highside environment"
          - "  2. Mount the drive on an operator RHEL workstation"
          - "  3. cd <drive_mount> && ./import_bundle.sh"
          - ""
          - "  !! IMPORTANT: The vault password is NOT on this drive."
          - "     It must travel via a separate trusted channel."
          - "════════════════════════════════════════════════════════════════"
