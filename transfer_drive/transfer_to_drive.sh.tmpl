#!/bin/bash
# transfer_to_drive.sh
# Generated by export_deployment.sh at @@LOG_TIMESTAMP@@
# DO NOT EDIT — regenerate by re-running export_deployment.sh on the lowside.
#
# Source provisioner: @@PROVISIONER_HOST@@
# Source satellite:   @@SAT_HOST@@
# Staging path:       @@EXPORT_STAGING@@
# Pulp export path:   @@PULP_EXPORT_PATH@@
# Highside target:    @@HIGHSIDE_DOMAIN@@
#
# Thin wrapper — generates an Ansible inventory and runs transfer_to_drive.yml.
# The playbook pulls staging artifacts from the provisioner and Pulp content
# from the satellite directly to the mounted transfer drive.
#
# ── Requirements ─────────────────────────────────────────────────────────────
#
# Operator workstation:
#   - RHEL (or compatible Linux) with ansible-core >= 2.14
#   - ansible.posix collection:
#       ansible-galaxy collection install ansible.posix
#   - transfer_to_drive.yml in the same directory as this script
#   - SSH access to both provisioner and satellite using the ansiblerunner key
#   - Transfer drive mounted and writable
#
# Provisioner (@@PROVISIONER_HOST@@):
#   - ansiblerunner can SSH in (key-based, BatchMode compatible)
#   - ansiblerunner can read the export staging path (no sudo needed)
#
# Satellite (@@SAT_HOST@@):
#   - ansiblerunner can SSH in (key-based, BatchMode compatible)
#   - ansiblerunner has sudo access to /var/lib/pulp/exports/
#
#   Sudo behaviour:
#     stat and du tasks:       Ansible become — works with passwordless or
#                              password sudo (use --ask-become-pass for the latter)
#     rsync (synchronize):     ansible.posix.synchronize with become: true injects
#                              --rsync-path="sudo rsync". This runs sudo rsync on
#                              the satellite via rsync's own SSH session, outside
#                              Ansible's become mechanism. It requires NOPASSWD
#                              for /usr/bin/rsync specifically, regardless of whether
#                              the full become password is set.
#
#   To satisfy both requirements in a password-sudo environment, add a targeted
#   sudoers entry on the satellite:
#       ansiblerunner ALL=(ALL) NOPASSWD: /usr/bin/rsync
#   Combined with --ask-become-pass for the stat/du tasks, this covers all cases
#   without granting blanket NOPASSWD: ALL.
#
# ── Usage ─────────────────────────────────────────────────────────────────────
#
#   ./transfer_to_drive.sh -d <drive_mount> [options]
#
# Options:
#   -d | --drive-mount <path>   Mount point of the transfer drive (REQUIRED)
#       --dry-run               Show plan and size estimate — do not transfer
#       --yes                   Skip confirmation prompt
#       --ask-become-pass       Prompt for sudo password on the satellite
#                               (needed for stat/du if passwordless sudo is
#                               not configured; see sudo note above)
#       --ssh-user <user>       SSH user for provisioner and satellite
#                               (default: ansiblerunner)
#       --ssh-key <path>        SSH private key path
#                               (default: ~/.ssh/id_ed25519)
#   -h | --help                 Show this help

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLAYBOOK="${SCRIPT_DIR}/transfer_to_drive.yml"
PROVISIONER_HOST="@@PROVISIONER_HOST@@"
SAT_HOST="@@SAT_HOST@@"

DRIVE_MOUNT=""
dry_run=false
skip_confirm=false
ask_become_pass=false
ssh_user="ansiblerunner"
ssh_key="${HOME}/.ssh/id_ed25519"

die()  { echo -e "${RED}ERROR: $*${NC}" >&2; exit 1; }

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -d|--drive-mount)     DRIVE_MOUNT="$2"; shift ;;
        --dry-run)            dry_run=true ;;
        --yes)                skip_confirm=true ;;
        --ask-become-pass)    ask_become_pass=true ;;
        --ssh-user)           ssh_user="$2"; shift ;;
        --ssh-key)            ssh_key="$2"; shift ;;
        -h|--help)
            sed -n '/^# ── Usage/,/^[^#]/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *) die "Unknown option: $1" ;;
    esac
    shift
done

[[ -z "${DRIVE_MOUNT}" ]] && die "-d <drive_mount> is required"
[[ -f "${PLAYBOOK}" ]] || die "transfer_to_drive.yml not found at ${PLAYBOOK}"
[[ -f "${ssh_key}" ]] || die "SSH key not found: ${ssh_key}"

if ! $skip_confirm && ! $dry_run; then
    echo ""
    echo -e "${YELLOW}This will rsync ${YELLOW}@@HIGHSIDE_DOMAIN@@${NC}${YELLOW} staging and Pulp content to ${DRIVE_MOUNT}.${NC}"
    read -rp "  Proceed with transfer? [y/N]: " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
fi

# ── Generate temporary Ansible inventory ─────────────────────────────────────

TMPINV=$(mktemp /tmp/rhis_transfer_inv_XXXXXX)
trap 'rm -f "${TMPINV}"' EXIT

cat > "${TMPINV}" <<EOF
[transfer_provisioner]
${PROVISIONER_HOST} ansible_user=${ssh_user} ansible_ssh_private_key_file=${ssh_key}

[transfer_satellite]
${SAT_HOST} ansible_user=${ssh_user} ansible_ssh_private_key_file=${ssh_key}

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o BatchMode=yes'
EOF

# ── Build ansible-playbook arguments ─────────────────────────────────────────

ANSIBLE_ARGS=(
    "${PLAYBOOK}"
    --inventory "${TMPINV}"
    --extra-vars "drive_mount=${DRIVE_MOUNT}"
)

$dry_run          && ANSIBLE_ARGS+=(--extra-vars "dry_run=true")
$ask_become_pass  && ANSIBLE_ARGS+=(--ask-become-pass)

# ── Run ───────────────────────────────────────────────────────────────────────

LOG_FILE="${SCRIPT_DIR}/transfer_to_drive_@@LOG_TIMESTAMP@@.log"

echo ""
printf "${GREEN}Start Time: %(%T)T${NC}\n" -1
echo -e "  Log: ${YELLOW}${LOG_FILE}${NC}"
SECONDS=0

ansible-playbook "${ANSIBLE_ARGS[@]}" 2>&1 | tee "${LOG_FILE}"
EXIT_CODE=${PIPESTATUS[0]}

duration=$SECONDS
printf "\n${GREEN}End Time: %(%T)T${NC}\n" -1
TZ=UTC0 printf "${GREEN}Elapsed Time: %(%T)T${NC}\n" $duration

exit $EXIT_CODE
