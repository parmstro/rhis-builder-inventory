---

provisioner:
  hosts:
    provisioner.{{ basevars_global_domain_name }}:
      connection: local
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(13) }}"
     
idm_primary:
  hosts:
    idm1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(10) }}"

sat_primary:
  hosts:  
    satellite1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(12) }}"

{% if rhis_system_count.idm is defined and rhis_system_count.idm > 1 %}
idm_replicas:
  hosts:
    idm2.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(11) }}"
{% for num in range(3, (rhis_system_count.idm | int) + 1) %}
    idm{{ num }}.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(40 - 3 + num) }}"
{% endfor %}
{% endif %}

{% if rhis_system_count.kvm_hypervisors is defined and rhis_system_count.kvm_hypervisors > 1 %}
kvm_hypervisors:
  hosts:
{% for num in range(1, (rhis_system_count.kvm_hypervisors | int) + 1) %}
    kvm{{ num }}.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(20 + num) }}"
{% endfor %}
{% endif %}

{% if rhis_system_count.capsule is defined and rhis_system_count.capsule > 0 %}
sat_capsules:
  hosts:
    capsule1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(16) }}"
{% for num in range(2, (rhis_system_count.capsule | int) + 1) %}
    capsule{{ num }}.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(45 - 2 + num) }}"
{% endfor %}
{% endif %}

sat_trusted_hosts:
  children:
    sat_primary:
    sat_capsules:

{% if rhis_system_count.aapcontroller is defined and rhis_system_count.aapcontroller > 0 %}
platform_installer:
  hosts:
    aapcontroller1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(14) }}"
{% endif %}

{% if rhis_system_count.aapcontroller is defined and rhis_system_count.aapcontroller > 0 %}
aap_controllers:
  hosts:
    aapcontroller1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(14) }}"
{% for num in range(2, (rhis_system_count.aapcontroller | int) + 1) %}
    {{ 'aapcontroller' ~ num ~ '.' ~ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(50 - 2 + num) }}"
{% endfor %}
{% endif %}

