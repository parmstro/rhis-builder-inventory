---
# ── IP Addressing Scheme ──────────────────────────────────────────────────────
# Band  Offsets    Purpose              .x0 reserved        Host offsets
# ──    1-9        Infra reserved       —                   —
# 10    10-29      IdM                  10 = primary        11-26 (max 16 replicas)
# 30    30-39      Core services        30 = emergency      31=gitea 32=satellite 33=provisioner 34=logserver
# 40    40-49      Capsules             40 = emergency      41-46 (max 6)
# 50    50-59      AAP Gateways         50 = emergency      51-59 (max 9)
# 60    60-69      AAP Controllers      60 = emergency      61-69 (max 9)
# 70    70-79      AAP EDA              70 = emergency      71-79 (max 9)
# 80    80-94      VMware               80 = vcenter        81-94 (max 14 esxi)
# ──    95-99      Buffer               —                   —
# 100   100-109    AAP Hubs             100 = emergency     101-109 (max 9)
# 110   110-119    AAP Databases        110 = emergency     111-119 (max 9)
# 120   120-129    Execution Nodes      120 = emergency     121-129 (max 9)
# 130   130-139    Hop Nodes            130 = emergency     131-139 (max 9)
# 140   140-149    KVM Hypervisors      140 = emergency     141-149 (max 9)
# 150   150-159    Quay                 150 = emergency     151-159 (max 9)
# 160   160-179    Quadlet              160 = emergency     161-178 (max 18)
# 180+  —          Future               —                   —
# ──────────────────────────────────────────────────────────────────────────────

# ── Band 10-29: IdM ──────────────────────────────────────────────────────────

idm_primary:
  hosts:
    idm1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(10) }}"

{% if rhis_system_count.idm is defined and rhis_system_count.idm > 1 %}
idm_replicas:
  hosts:
{% for num in range(2, (rhis_system_count.idm | int) + 1) %}
    idm{{ num }}.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(9 + num) }}"
{% endfor %}
{% endif %}

# ── Band 30-39: Core Services ────────────────────────────────────────────────

{% if rhis_system_count.gitea is defined and rhis_system_count.gitea > 0 %}
gitea_servers:
  hosts:
{% for num in range(1, (rhis_system_count.gitea | int) + 1) %}
    {{ 'gitea' ~ num ~ '.' ~ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(30 + num) }}"
{% endfor %}
{% endif %}

sat_primary:
