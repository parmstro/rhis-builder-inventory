sat_trusted_hosts:
  children:
    sat_primary:
    sat_capsules:

# ── Band 50-59: AAP Gateways ─────────────────────────────────────────────────

{% if rhis_system_count.aapgateway is defined and rhis_system_count.aapgateway == 0 and rhis_system_count.aapcontroller is defined and rhis_system_count.aapcontroller == 1 %}
# Growth mode: single AAP controller with no gateway, controller serves as gateway
aap_gateways:
  hosts:
    aapcontroller1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(61) }}"
{% elif rhis_system_count.aapgateway is defined and rhis_system_count.aapgateway > 0 %}
aap_gateways:
  hosts:
{% for num in range(1, (rhis_system_count.aapgateway | int) + 1) %}
    {{ 'aapgateway' ~ num ~ '.' ~ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(50 + num) }}"
{% endfor %}
{% else %}
# WARNING: No AAP gateway defined, and no AAP controller defined.  This is likely a misconfiguration.
{% endif %}

