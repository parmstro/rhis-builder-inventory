{% if rhis_system_count.quadlet is defined and rhis_system_count.quadlet > 0 %}
container_servers:
  hosts:
{% for num in range(1, (rhis_system_count.quadlet | int) + 1) %}
    {{ 'quadlet' ~ num ~ '.' ~ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(17 - 1 + num) }}"
{% endfor %}
{% endif %}

{% if rhis_system_count.quay is defined and rhis_system_count.quay > 0 %}
quay_servers:
  hosts:
{% for num in range(1, (rhis_system_count.quay | int) + 1) %}
    {{ 'quay' ~ num ~ '.' ~ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(71 - 1 + num) }}"
{% endfor %}
{% endif %}

