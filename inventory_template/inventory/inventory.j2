    satellite1.{{ basevars_global_domain_name }}:
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(32) }}"

provisioner:
  hosts:
    provisioner.{{ basevars_global_domain_name }}:
      connection: local
      ipv4_address: "{{ [default_network, '/', default_network_prefix] | join() | ansible.utils.next_nth_usable(33) }}"

{% if rhis_system_count.logserver is defined and rhis_system_count.logserver > 0 %}
