---

# Add the global DNS Forwarders and Forward Policy to the IdM server configuration
# Internet address requests must be service by an internet DNS server, 
# so we will use the Google DNS servers as the forwarders for this example. 
# You can change these to your own preferred DNS servers if you wish.

idm_dns_global_configuration:
  forwarders:
    - ip_address: "8.8.8.8"
    - ip_address: "8.8.4.4"
  forward_policy: "first"
  allow_sync_ptr: true

# Testing zone forwarding for parmstrong.ca — resolve demo environment hosts from example.ca
# If you need internal zone forwarding, you can add the zone name and the forwarders here.

idm_dns_forward_zones:
  - name: "parmstrong.ca"
    forwarders:
      - ip_address: "192.168.252.10"
      - ip_address: "192.168.252.11"
    forward_policy: "only"
    skip_overlap_check: true

# Reverse zone BIND update policies are managed by rhis-builder-satellite (ensure_idm_dns_config)
# during the prepare_realm phase — the realm-capsule principal name is owned by satellite,
# so IdM configuration must not grant permissions to it directly.
idm_dns_zones:
{% for zone in default_network_reverse_dns_zones %}
  - name: "{{ zone }}"
{% endfor %}

{% raw %}

# you probably want to add some standard records to the new DNS
# NOTE: Most records can be a list or string 
# e.g. "A" records can be a list of IP addresses or a single IP address string
# e.g. "PTR" records can be a list of hostnames or a single hostname string - remember to add the trailing dot to the hostname if you are using a string

idm_dns_records:
  # Service records
  - name: "_x-foreman._tcp"
    zone_name: "{{ _runtime_global_domain_name }}"
    record_type: "SRV"
    srv_port: "443"
    srv_priority: "0"
    srv_weight: "5"
    srv_target: "{{ groups['sat_primary'][0] }}."
    state: "present"

  # IP Address for non-registered hosts
  - name: "router"
    zone_name: "{{ _runtime_global_domain_name }}"
    record_type: "A"
    {% endraw %}ip_address: "{{ target_net_cidr | ansible.utils.next_nth_usable(1) }}"
    {% raw %}a_create_reverse: true
    state: "present"

  # Example records for OCP deployment
  - name: "ocp1.{{ _runtime_global_domain_name }}"
    zone_name: "{{ _runtime_global_domain_name }}"
    record_type: "A"
    {% endraw %}ip_address: "{{ target_net_cidr | ansible.utils.next_nth_usable(1001) }}"
    {% raw %}a_create_reverse: false
    state: "present"

  - name: "*.api.ocp1.{{ _runtime_global_domain_name }}"
