---

# NOTE: This file replaces the previous redhat_manifests and subscription_manifests files.
# Manifest behaviour is determined at inventory render time by basevars_disconnected_domain.
#
# If generate is true we will either create or destroy the manifest based on state.
# If generate is false a valid manifest ZIP must be provided in source and placed in files/.
# WARNING: manifest ZIPs are sensitive — the default .gitignore excludes all ZIPs in files/.

{% if basevars_disconnected_domain | default(false) %}
# DISCONNECTED: satellite cannot reach subscription.rhsm.redhat.com.
# Place <satellite_fqdn>_manifest.zip in your deployment's files/ directory before building.
{% raw %}
redhat_manifests:
  - name: "{{ ansible_fqdn }}"
    source: "{{ ansible_fqdn }}_manifest.zip"
    generate: false
    organization: "{{ satellite_organization }}"
    state: present
{% endraw %}

{% else %}
# CONNECTED: manifest generated from CDN.
# cdn_username must have permission to create manifests in the account.
{% raw %}
redhat_manifests:
  - name: "{{ ansible_fqdn }}"
    account: "{{ cdn_account_number_vault }}"
    cdn_username: "{{ cdn_username_vault }}"
    cdn_password: "{{ cdn_password_vault }}"
    content_access_mode: "org_environment"  # SCA mode
    generate: true
    organization: "{{ satellite_organization }}"
#   source: org_name_versionstring.zip  # when providing your own manifest
    path: "/root/bootstrap_manifest.zip"
    portal_url: "https://subscription.rhsm.redhat.com"
#   repository_url:  # alternate content source
    state: present   # present | absent | refreshed
    subs: "{{ manifest_subs_vault }}"
    validate_certs: true
{% endraw %}

{% endif %}
