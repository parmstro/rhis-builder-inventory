---
# Import any git repos into the base OS of the Satellite Server
# This is used primarily to sync and ingest Ansible Roles for:
# ansible role from compliance as code project / RedHatOfficial

# This really allows you to import any git repos that may contain content
# that you otherwise want to reference in your build

# DISCONNECTED DEPLOYMENTS:
# Ansible roles arrive via the transfer bundle. bundle_delivery installs them to
# /etc/ansible/roles/ before main.yml runs. The git clone loop below is skipped
# by default on disconnected satellites.
#
# Set satellite_imported_git_repos_override: true if this satellite has access to
# a highside git server (e.g. Gitea on the provisioner node) and you want to clone
# or update roles from it. Update the repository URLs in git_repos to point to the
# highside server before enabling this.
satellite_imported_git_repos_override: false

git_repos:
# RHEL9
  - repository: "https://github.com/RedHatOfficial/ansible-role-rhel9-e8.git"
    dest: "/etc/ansible/roles/ansible-role-rhel9-e8"
    clone: {{ 'false' if basevars_disconnected_domain | default(false) else 'true' }}
    force: true
