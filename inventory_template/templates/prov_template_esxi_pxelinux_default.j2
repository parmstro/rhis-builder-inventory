<%#
name: ESXi PXELinux Default
snippet: false
model: ProvisioningTemplate
kind: PXELinux
description: |
  PXELinux template for VMware ESXi installation via Satellite.
  Uses mboot.c32 as the boot loader with ESXi-specific boot.cfg.
  The kickstart URL points to Satellite's provision template endpoint.
-%>
# This file was deployed via '<%= template_name %>' template
<%
  timeout = host_param('loader_timeout').to_i * 10
  timeout = 200 if timeout.nil? || timeout <= 0
  esxi_media_path = host_param('esxi_media_path') || '/esxi'
-%>
DEFAULT menu
MENU TITLE ESXi Installer (ESC to stop)
TIMEOUT <%= timeout %>
ONTIMEOUT installer

LABEL installer
  MENU LABEL <%= template_name %>
  KERNEL <%= esxi_media_path %>/mboot.c32
  APPEND -c <%= esxi_media_path %>/boot.cfg ks=<%= foreman_url('provision') %>
