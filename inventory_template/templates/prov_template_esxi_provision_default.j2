<%#
name: ESXi Provision Default
snippet: false
model: ProvisioningTemplate
kind: provision
description: |
  ESXi kickstart (ks.cfg) template for unattended VMware ESXi installation.
  Deployed via Satellite provisioning to discovered baremetal hosts.

  This template accepts the following host parameters:
  - esxi_root_password: string (hashed root password)
  - esxi_install_disk: string (default="--firstdisk")
  - esxi_mgmt_vlan: integer (default=0, no VLAN)
  - esxi_mgmt_nic: string (default="vmnic0")
  - esxi_enable_ssh: boolean (default=true)
  - esxi_enable_shell: boolean (default=true)
  - ntp-server: string (NTP server address)
  - esxi_syslog_server: string (optional remote syslog)
-%>
<%
  esxi_install_disk = host_param('esxi_install_disk') || '--firstdisk'
  esxi_mgmt_vlan = host_param('esxi_mgmt_vlan') || '0'
  esxi_mgmt_nic = host_param('esxi_mgmt_nic') || 'vmnic0'
  esxi_enable_ssh = host_param_true?('esxi_enable_ssh', true)
  esxi_enable_shell = host_param_true?('esxi_enable_shell', true)
  ntp_server = host_param('ntp-server')
  esxi_syslog = host_param('esxi_syslog_server')
-%>
# ESXi kickstart generated by Satellite — <%= template_name %>

accepteula

install <%= esxi_install_disk %> --overwritevmfs

rootpw --iscrypted <%= root_pass %>

<% if @host.ip && @host.subnet -%>
network --bootproto=static --device=<%= esxi_mgmt_nic %> --ip=<%= @host.ip %> --netmask=<%= @host.subnet.mask %> --gateway=<%= @host.subnet.gateway %> --hostname=<%= @host.name %> --nameserver=<%= @host.subnet.dns_primary %><% if esxi_mgmt_vlan.to_i > 0 %> --vlanid=<%= esxi_mgmt_vlan %><% end %>
<% else -%>
network --bootproto=dhcp --device=<%= esxi_mgmt_nic %>
<% end -%>

reboot

%firstboot --interpreter=busybox

<% if esxi_enable_ssh -%>
vim-cmd hostsvc/enable_ssh
vim-cmd hostsvc/start_ssh
<% end -%>

<% if esxi_enable_shell -%>
vim-cmd hostsvc/enable_esx_shell
vim-cmd hostsvc/start_esx_shell
<% end -%>

<% if ntp_server -%>
esxcli system ntp set --server=<%= ntp_server %>
esxcli system ntp set --enabled=true
<% end -%>

<% if esxi_syslog -%>
esxcli system syslog config set --loghost='<%= esxi_syslog %>'
esxcli system syslog reload
<% end -%>

# Suppress ESXi CEIP
esxcli system settings advanced set -o /UserVars/HostClientCEIPOptIn -i 2

<%= snippet 'built' %>
