<%#
name: ESXi PXEGrub2 Default
snippet: false
model: ProvisioningTemplate
kind: PXEGrub2
description: |
  PXEGrub2 UEFI template for VMware ESXi installation via Satellite.
  Chainloads mboot.efi with ESXi boot.cfg and kickstart URL.
-%>
# This file was deployed via '<%= template_name %>' template
<%
  timeout = host_param('loader_timeout').to_i
  timeout = 20 if timeout.nil? || timeout <= 0
  esxi_media_path = host_param('esxi_media_path') || '/esxi'
-%>

set default=0
set timeout=<%= timeout %>

menuentry '<%= template_name %>' {
  chainloader <%= esxi_media_path %>/mboot.efi -c <%= esxi_media_path %>/boot.cfg ks=<%= foreman_url('provision') %>
}
