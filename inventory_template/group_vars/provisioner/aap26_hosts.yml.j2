---

# PATTERN: aap26_hosts is a payload variable consumed via extra-vars dispatch:
#   --extra-vars "platform_hosts=<aap26_hosts>"
# No version-specific deploy script exists yet for aap26_hosts; it will be
# assigned to platform_hosts by the deploy script when one is created.
# NOTE: Version-based AAP host list naming (aap24_hosts, aap26_hosts) is being
# phased out in favour of a version-neutral name. This file will be renamed
# as part of that transition.
# Static analysis tools will not detect aap26_hosts as "used" — expected. See
# schema/audit_findings.md Scanner Limitation.


# AAP 2.6 Growth Deployment
{% raw %}
aap26_hosts:

  - name: "aapcontroller1"
    fqdn: "aapcontroller1.{{ _runtime_global_domain_name }}"
    delete_host: false
    organization: "{{ satellite_organization }}"
    location: "{{ satellite_location }}"
    hostgroup: "hg_x86_64_rhel9_metal/aap9_26"
    kickstart_repository: "Red Hat Enterprise Linux 9 for x86_64 - BaseOS Kickstart 9.7"
    compute_resource: "baremetal"
    parameters:
      - name: "boot_disk"
        parameter_type: "string"
        value: "/dev/nvme0n1"
      - name: "root_disk"
        parameter_type: "string"
        value: "/dev/nvme0n1"
    interfaces_attributes:
      - type: "interface"
        identifier: "{{ _default_provision_iface }}"
        domain: "{{ _default_domain }}"
        execution: true
        managed: true
        primary: true
        provision: true
        subnet: "{{ _default_subnetname }}"
        mac: "{{ hostvars[groups['aap_controllers'][0]].mac_address | default('94:c6:91:a3:19:29') }}"
        ip: "{{ hostvars[groups['aap_controllers'][0]].ipv4_address }}"

