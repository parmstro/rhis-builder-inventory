---

# PATTERN: aap24_hosts is a payload variable consumed via extra-vars dispatch:
#   --extra-vars "platform_hosts=<aap24_hosts>"
# The deploy script (deploy_aap24_hosts.sh) assigns it to the generic platform_hosts
# variable that the create_hosts.yml playbook operates on.
# NOTE: Version-based AAP host list naming (aap24_hosts, aap26_hosts) is being
# phased out in favour of a version-neutral name. This file will be renamed
# as part of that transition.
# Static analysis tools will not detect aap24_hosts as "used" — expected. See
# schema/audit_findings.md Scanner Limitation.

# Ansible 2.4 growth deployment
{% raw %}
aap24_hosts:

  - name: "aapcontroller1"
    fqdn: "aapcontroller1.{{ _runtime_global_domain_name }}"
    delete_host: false
    organization: "{{ satellite_organization }}"
    location: "{{ satellite_location }}"
    hostgroup: "hg_x86_64_rhel9_metal/aap9_24"
    kickstart_repository: "Red Hat Enterprise Linux 9 for x86_64 - BaseOS Kickstart 9.7"
    compute_resource: "baremetal"
    parameters:
      - name: "boot_disk"
        parameter_type: "string"
        value: "/dev/nvme0n1"
      - name: "root_disk"
        parameter_type: "string"
        value: "/dev/nvme0n1"
    interfaces_attributes:
      - type: "interface"
        identifier: "{{ _default_provision_iface }}"
        domain: "{{ _default_domain }}"
        execution: true
        managed: true
        primary: true
        provision: true
        subnet: "{{ _default_subnetname }}"
        mac: "54:b2:03:f1:0b:6a"
        ip: "{{ _default_network }}.14"

  - name: "aaphub1"
    fqdn: "aaphub1.{{ _runtime_global_domain_name }}"
    delete_host: false
    organization: "{{ satellite_organization }}"
    location: "{{ satellite_location }}"
    hostgroup: "hg_x86_64_rhel9_metal/aap9_24"
    kickstart_repository: "Red Hat Enterprise Linux 9 for x86_64 - BaseOS Kickstart 9.7"
    compute_resource: "baremetal"
    parameters:
      - name: "boot_disk"
        parameter_type: "string"
        value: "/dev/nvme0n1"
      - name: "root_disk"
        parameter_type: "string"
        value: "/dev/nvme0n1"
    interfaces_attributes:
      - type: "interface"
        identifier: "{{ _default_provision_iface }}"
        domain: "{{ _default_domain }}"
        execution: true
        managed: true
        primary: true
        provision: true
        subnet: "{{ _default_subnetname }}"
        mac: "54:b2:03:f1:0b:46"
        ip: "{{ _default_network }}.15"
{% endraw %}
...
